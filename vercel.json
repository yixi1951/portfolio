{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/math1", "destination": "/math1/index.html" },
    { "source": "/math1/", "destination": "/math1/index.html" },
    { "source": "/((?!math1(?:/|$)).*)", "destination": "/index.html" }
  ]
}
